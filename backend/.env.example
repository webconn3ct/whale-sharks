# Supabase Postgres — pooled connection (pgbouncer, transaction mode, port 6543), used at runtime
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[PROJECT_REF].pooler.supabase.com:6543/postgres

# Supabase Postgres — direct connection (port 5432), used only by Alembic migrations
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Scan scheduling
SCAN_INTERVAL_MINUTES=15
SCAN_RETENTION_DAYS=14

# Consensus scoring (see app/core/consensus_engine.py)
VALUE_NORMALIZER=6
MAX_VALUE_BOOST=1.0

# Logging
LOG_LEVEL=INFO
